# Base public path untuk Vite & React Router
# Gunakan "/" untuk deploy di root domain, atau "/MokaPro/" untuk deploy di subfolder (mis. GitHub Pages)
VITE_BASE_PATH=/

# Target URL untuk Vite dev server proxy (/api dan /sanctum)
MOKAPRO_BACKEND_URL=http://127.0.0.1:8000

# Opsional: Base URL API backend untuk build production cross-origin (mis. https://api.mokapro.id)
# Kosongkan jika frontend dan backend berada di origin yang sama / di balik satu reverse proxy Nginx/Apache
VITE_API_URL=
